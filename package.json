{
  "name": "herdr-plugin-sessionizer",
  "version": "0.9.0",
  "private": true,
  "type": "module",
  "description": "Herdr plugin inspired by ThePrimeagen's tmux-sessionizer for fuzzy project and worktree picking",
  "license": "MIT",
  "bin": {
    "herdr-worktree": "./src/bin/herdr-worktree.ts"
  },
  "scripts": {
    "build": "mkdir -p dist && bun build ./src/cli.ts --compile --outfile dist/sessionizer && if uname | grep -q Darwin; then codesign --force --deep --sign - --timestamp=none dist/sessionizer; fi",
    "sessionizer": "bun run src/sessionizer/sessionizer.ts",
    "worktree": "bun run src/bin/herdr-worktree.ts",
    "release": "bun run scripts/release/prep.ts",
    "release:tag": "bun run scripts/release/tag.ts",
    "release:notes": "bun run scripts/release/notes.ts",
    "test": "bun test --path-ignore-patterns='**/*.integration.test.ts'",
    "test:integration": "bun test src/worktree/candidates.integration.test.ts",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint --type-aware",
    "lint:fix": "oxlint --type-aware --fix",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "prepare": "lefthook install"
  },
  "dependencies": {
    "smol-toml": "^1.3.4"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "lefthook": "^2.1.12",
    "oxfmt": "^0.67.0",
    "oxlint": "^1.82.0",
    "oxlint-tsgolint": "^7.0.2001",
    "typescript": "^7.0.0"
  }
}
